msgstr "Validate stock"

msgid "Registros de producción"
msgstr "Production records"

msgid "Cada registro define cuántas unidades de un plato están disponibles en una fecha. El <strong>Dish ID</strong> es la PK numérica (entera) del plato en la base de datos."
msgstr "Each record defines how many units of a dish are available on a date. The <strong>Dish ID</strong> is the numeric (integer) PK of the dish in the database."

msgid "Fecha"
msgstr "Date"

msgid "Filtrar"
msgstr "Filter"

msgid "Ver todos"
msgstr "View all"

msgid "Usa los filtros o \"Ver todos\""
msgstr "Use the filters or \"View all\""

msgid "Crear producción diaria"
msgstr "Create daily production"

msgid "El <strong>Dish ID</strong> debe ser el entero que la base de datos asignó al plato (visible en el admin de Django o con una consulta directa)."
msgstr "The <strong>Dish ID</strong> must be the integer assigned by the database to the dish (visible in Django admin or with a direct query)."

msgid "Dish ID (numérico)"
msgstr "Dish ID (numeric)"

msgid "Unidades disponibles"
msgstr "Available units"

msgid "Crear registro"
msgstr "Create record"

msgid "Ajustar cupos"
msgstr "Adjust capacity"

msgid "ID del registro de producción"
msgstr "Production record ID"

msgid "Nuevos cupos disponibles"
msgstr "New available units"

msgid "Aplicar ajuste"
msgstr "Apply adjustment"

msgid "Producto no encontrado"
msgstr "Product not found"

msgid "El parámetro 'name' es obligatorio"
msgstr "The 'name' parameter is required"

msgid "Registro de producción no encontrado"
msgstr "Production record not found"

msgid "La cantidad a reservar debe ser mayor a 0"
msgstr "The quantity to reserve must be greater than 0"

