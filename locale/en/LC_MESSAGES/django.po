msgstr "A production record already exists for dish_id=%(dish_id)s on date=%(date)s"

msgid "No existe producción con id=%(production_id)s"
msgstr "No production record exists with id=%(production_id)s"

msgid "Ya existe un usuario con el email '%(email)s'."
msgstr "A user with email '%(email)s' already exists."

msgid "Este usuario ya tiene un perfil de cliente."
msgstr "This user already has a customer profile."

msgid "Este usuario ya tiene un perfil de cocinero."
msgstr "This user already has a cook profile."

msgid "Usuario con id=%(user_id)s no encontrado."
msgstr "User with id=%(user_id)s not found."

msgid "Orden no encontrada"
msgstr "Order not found"

msgid "No autorizado"
msgstr "Unauthorized"

msgid "Orden %(order_id)s confirmada"
msgstr "Order %(order_id)s confirmed"

msgid "Orden %(order_id)s cancelada"
msgstr "Order %(order_id)s canceled"

msgid "Stock de producción disponible para todos los ítems"
msgstr "Production stock is available for all items"

msgid "Stock insuficiente para el plato %(dish_id)s"
msgstr "Insufficient stock for dish %(dish_id)s"

msgid "Orden %(order_id)s no encontrada."
msgstr "Order %(order_id)s not found."

msgid "Usuario requerido"
msgstr "User is required"

msgid "Ítems requeridos"
msgstr "Items are required"

msgid "Fecha requerida"
msgstr "Date is required"

msgid "Cupos insuficientes para el plato %(dish_id)s"
msgstr "Insufficient capacity for dish %(dish_id)s"

msgid "Pedido %(order_id)s recibido. Confirmación enviada."
msgstr "Order %(order_id)s received. Confirmation sent."

msgid "Pedido %(order_id)s confirmado."
msgstr "Order %(order_id)s confirmed."

msgid "Pedido %(order_id)s cancelado."
msgstr "Order %(order_id)s canceled."

msgid "Correo de confirmación enviado para el pedido %(order_id)s."
msgstr "Confirmation email sent for order %(order_id)s."

msgid "Correo de pedido confirmado enviado para %(order_id)s."
msgstr "Confirmed-order email sent for %(order_id)s."

msgid "Correo de pedido cancelado enviado para %(order_id)s."
msgstr "Canceled-order email sent for %(order_id)s."

msgid "Evento de pedido no soportado: %(event)s"
msgstr "Unsupported order event: %(event)s"

msgid "Notificación %(event)s procesada para pedido %(order_id)s (usuario=%(email)s, estado=%(status)s, entrega=%(delivery)s, total=%(total)s)."
msgstr "Notification %(event)s processed for order %(order_id)s (user=%(email)s, status=%(status)s, delivery=%(delivery)s, total=%(total)s)."

msgid "sin fecha"
msgstr "no date"

msgid "No se encontró el pedido %(order_id)s para el evento %(event)s."
msgstr "Order %(order_id)s was not found for event %(event)s."

msgid "Reporte diario actualizado para %(delivery_date)s: %(report)s"
msgstr "Daily report updated for %(delivery_date)s: %(report)s"

msgid "No se puede confirmar una orden en estado '%(status)s'"
msgstr "An order in '%(status)s' status cannot be confirmed"

msgid "La orden ya está cancelada"
msgstr "The order is already canceled"

msgid "%(field_name)s debe ser numérico"
msgstr "%(field_name)s must be numeric"

msgid "price no puede ser negativo"
msgstr "price cannot be negative"

msgid "stock debe ser un entero >= 0"
msgstr "stock must be an integer >= 0"

msgid "Cantidad debe ser un entero mayor a 0"
msgstr "Quantity must be an integer greater than 0"

msgid "Stock insuficiente para '%(product_name)s'. Disponible=%(available)s, solicitado=%(requested)s"
msgstr "Insufficient stock for '%(product_name)s'. Available=%(available)s, requested=%(requested)s"

msgid "El descuento no puede ser negativo"
msgstr "The discount cannot be negative"

msgid "%(field_name)s no puede estar vacío"
msgstr "%(field_name)s cannot be empty"

msgid "Correo electrónico inválido"
msgstr "Invalid email address"

msgid "El usuario ya tiene un perfil de cliente"
msgstr "The user already has a customer profile"

msgid "El usuario ya tiene un perfil de cocinero"
msgstr "The user already has a cook profile"

msgid "full_name no puede estar vacío"
msgstr "full_name cannot be empty"

msgid "Número de teléfono inválido"
msgstr "Invalid phone number"

msgid "name no puede estar vacío"
msgstr "name cannot be empty"

msgid "specialty no puede estar vacío"
msgstr "specialty cannot be empty"

msgid "Hacer pedido"
msgstr "Place order"

msgid "Platos y menú"
msgstr "Menu & dishes"

msgid "Plan del día"
msgstr "Daily plan"

msgid "Paso 1"
msgstr "Step 1"

msgid "Paso 2"
msgstr "Step 2"

msgid "Paso 3"
msgstr "Step 3"

msgid "Define el plato (nombre, precio, stock)."
msgstr "Define the dish (name, price, stock)."

msgid "Anota el código numérico de la tarjeta."
msgstr "Note the numeric code on the card."

msgid "Abre cupos en Plan del día con ese código."
msgstr "Open capacity in Daily plan with that code."

msgid "Aquí gestionas la ficha del producto. El <strong>código numérico</strong> de cada tarjeta (estable en esta sesión) es el <code>dish_id</code> para producción y pedidos."
msgstr "Manage the product record here. Each card's <strong>numeric code</strong> (stable for this session) is the <code>dish_id</code> for production and orders."

msgid "Elige platos (precio fijo del menú)."
msgstr "Choose dishes (fixed menu price)."

msgid "Indica dirección y fecha de entrega."
msgstr "Enter delivery address and date."

msgid "Confirma el pedido."
msgstr "Confirm the order."

msgid "Los <strong>cupos</strong> mostrados son los del plan del día para la fecha de entrega seleccionada (no el stock del catálogo). Cambia la fecha para ver disponibilidad actualizada."
msgstr "The <strong>capacity</strong> shown is from the daily plan for the selected delivery date (not catalog stock). Change the date to refresh availability."

msgid "Atajo de pedido (staff)"
msgstr "Order shortcut (staff)"

msgid "Solo para pruebas: indica el código del plato; si está en el menú cargado, nombre y precio se rellenan solos."
msgstr "Testing only: enter the dish code; if it is in the loaded menu, name and price fill automatically."

msgid "Código del plato"
msgstr "Dish code"

msgid "Nombre (referencia)"
msgstr "Name (reference)"

msgid "Precio unitario (menú)"
msgstr "Unit price (menu)"

msgid "Agregar al pedido"
msgstr "Add to order"

msgid "Código plato"
msgstr "Dish code"

msgid "Cupos disponibles por fecha. Usa el <strong>mismo código numérico</strong> que aparece en Platos y menú."
msgstr "Capacity per date. Use the <strong>same numeric code</strong> shown in Menu & dishes."

msgid "El <strong>código del plato</strong> es el número de la tarjeta en Platos y menú (ej. 1, 2, 3)."
msgstr "The <strong>dish code</strong> is the number on the card in Menu & dishes (e.g. 1, 2, 3)."

msgid "Usa los filtros o \"Ver todos\""
msgstr "Use the filters or \"View all\""
